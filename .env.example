# ============================================================
# DocPilot 环境变量模板
# 使用方法:复制本文件为 .env 并填入真实 key(.env 已被 .gitignore 排除)
# ============================================================

# ---- DeepSeek API(对话 / 翻译 / 评估 judge)----
# 申请:https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- SiliconFlow API(embedding + rerank,开源模型 API)----
# 申请:https://cloud.siliconflow.cn  (新用户通常有赠送额度)
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
